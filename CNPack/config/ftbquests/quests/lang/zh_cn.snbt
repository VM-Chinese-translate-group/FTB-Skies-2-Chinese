	quest.30053CAD8FABA638.title: "&f石头和泥土蜂巢"
	quest.302A4F4F2971CF8E.quest_desc: [
		"The &7Earth Talisman&r allows you to turn dirt into grass by right-clicking dirt with an empty hand."

	quest.790B688EBB673CBA.title: "&f魔法&d种子"
	quest.7913B52AD9D28D2B.quest_desc: ["A massive stronghold found in the Nether. This castle's core harbors a destructive &4Harbinger&r, guarded by Watchers and Prowlers."]

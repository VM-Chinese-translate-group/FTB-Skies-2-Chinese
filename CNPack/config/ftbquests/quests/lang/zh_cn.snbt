	quest.2CA74676EAC1A040.quest_subtitle: "&o感觉烧脑就吃点药吧"
	quest.2CA74676EAC1A040.title: "&a系统频率"
	quest.2CB418AE76610E8F.quest_desc: [
		"The &aWrench&r can be used to rotate network devices or dismantle them when used while crouching."
		""
		"Dismantling a network device retains all its current settings and upgrades."
	]
	quest.2CB418AE76610E8F.quest_subtitle: "扳手再多也不嫌多"
	quest.2CB418AE76610E8F.title: "&f扳手"
	quest.2CBB753B405D3888.quest_desc: [
		"With the &bCelestigem Hoe&r, you can use it to create &dVoidShimmer Soil&r."

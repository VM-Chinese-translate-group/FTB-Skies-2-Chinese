	quest.37D23D46198DA708.title: "&f方块交互组件"
	quest.37E9DC506653FCCA.quest_desc: [
		"我们拥有了升级到&d数字电路&r所需的一切。"
		""
		"一个新时代——&d高压时代&r来临了。"

	quest.5A284AE3AC14D070.title: "&f游玩&b1小时"
	quest.5A38A7792BCD6116.title: "&b机会二十面体"
	quest.5A4BD762C1792546.title: "&5蚀空合金斧"
	quest.5A57DB728220261F.quest_desc: [
		"The &2Agronomic Sourcelink&r will generate &dSource&r from crop or tree growth within 15 blocks of it. You can get bonus &dSource&r from magical plants, like &9Magebloom&r, &9Source Berry Bushes&r, or &aArchwood Trees&r."
		""
		"The &dSource&r that is created will output to a &aSource Jar&r within 5 blocks of it."
		""
		"&eNote&r: You cannot bone meal crops to speed up making Source, but there may be some other ways to speed this up..."
	]
	quest.5A57DB728220261F.title: "&2农艺魔源通道"
	quest.5A5D6A90C0999828.quest_desc: [
		"&3进阶机器外壳&r用于制造各种&3中压机器&r，这标志着我们进入了&3中压时代&r。"
		""
		"你也可以给现有的&2低压&r机器的升级槽插入进阶机器外壳，这样它们就可以接入中压电并处理&3中压&r配方。"
		""
		"你没想到自己必须在每个时期都分别造一批新机器，对吧？"
	]
	quest.5A5D6A90C0999828.title: "&3进阶机器框架"
	quest.5A6151C5CBCBAAF4.quest_desc: [
		"The &dHeart Amulet&r holds all your &2Heart Canisters&r. "
		""
		"You add them into the amulet and equip them in the &eCurios Slot&r."
		""
		"You can press Shift when hovering over the item to see how many Total Canisters is stored inside."
		""
		"You can have a total of &b40&r extra hearts in a base amulet."
	]
	quest.5A6151C5CBCBAAF4.title: "心之护符"
	quest.5A7D39C555A4D031.title: "&b坚固蜜蜂笼"
	quest.5A818D2F39A6679B.quest_subtitle: "+15% 法术冷却缩减"

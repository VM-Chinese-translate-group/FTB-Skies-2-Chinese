	quest.0FA7ECE8C07ADAB1.title: "&d凋亡符石"
	quest.0FA81BDE4918C7F7.quest_desc: [
		"&6增压柴油&r是最好的流体燃料。"
		""
		"注意：你需要&2乙醚&r才能制造它。（在下方石化蒸馏产物树中可以找到该材料）"

	quest.1D2DF91FC1559504.title: "&f自定义箭矢"
	quest.1D401E12D1F46227.quest_desc: ["接下来，你需要在&3化学反应釜&r中把等量的&a氢&r和&e氯&r混合，制成&c盐酸&r（HCl）。"]
	quest.1D401E12D1F46227.title: "&e盐酸"
	quest.1D410DFB7EFEE4CE.quest_desc: ["&aCoffee Beans&r can be found in the wild, and can be harvested to make &aCoffee&r."]
	quest.1D410DFB7EFEE4CE.title: "&a咖啡豆"
	quest.1D4B75C5103D3723.quest_desc: [
		"&c红石&r频道是功能最复杂的频道，但如果你对红石颇有了解，那它可能会非常有用。"
		""
		"{image:ftb:textures/quests/xnet/logic_channel.png width:260 height:80 align:center}"
		""
		"&7关于每种模式的详细讲解在下一页->"
		"{@pagebreak}"
		"监测模式有着至多四条监测选项。它可以监测物品、流体、能量，或是红石信号。"
		""
		"这些监测还可以根据运算符（=，！=，<，>，<=，>=）来监测物品的数量。随后，它会将结果输出，并跟一个颜色代码绑定在一起。这个颜色代码可用于调控另一个已连接的机器，也可以用于调控处于“输出”模式的红石频道。"
		""
		""
		"输出模式有多种输出选项：直接、反相、或门、与门、或非、与非、异或、同或、切换、数量、时间，以及指定输出。这其中大部分都是编程相关，所以即使你不了解它们也不用担心，反正你很可能用不上其中的大部分选项。"
	]
	quest.1D572D53A6EE3205.quest_desc: ["在&2采石机&r中挖出&a铂矿石&r后，我们就可以把它粉碎变为&b粗铂&r。"]
	quest.1D572D53A6EE3205.title: "&d粗铂"
	quest.1D6D9CCF4E0072E1.title: "&f金矿块"
	quest.1D846D3D48C87FC4.quest_desc: [
		"&7&n&oChoose one of the following:"
		""
		"&7&o- ME Import Bus"
		"&7&o- ME Export Bus"
		"&7&o- ME Interface"
		"&7&o- ME Storage Bus"
	]
	quest.1D846D3D48C87FC4.title: "&bAE2总线奖励包"
	quest.1DA78BAB2A6E2C82.quest_desc: [
		"For modded veterans, &eEnderIO&r held great memories due to its amazing pipes, called &dConduits&r."
		""
		"These &dConduits&r are highly configurable, and can even store multiple conduits in the same block space. If you don't like the look of the cables, you can also slap on a &2Facade&r to cover them up!"
		""
		"Configuring them is made easy using the &aYeta Wrench&r. If any pipe is hidden beneath a &2Facade&r, holding the wrench in your hand will uncover them for easy configuration."
	]
	quest.1DA78BAB2A6E2C82.title: "&e末影接口"
	quest.1DBAC590575ABA64.quest_desc: [
		"有三种特别的母岩。"
		""
		"焦黑石英和钨母岩可以通过&c引爆&r&3虚无晶体催化剂&r和相应的资源来获取。"
		""
		"而独居石母岩通过一个独特的化学过程来取得，且只在&e现代工业化&r模组中会用到。"
	]
	quest.1DBAC590575ABA64.title: "&f小众矿晶"
	quest.1DBE1D496463B310.quest_desc: [
		"&3中压蒸汽涡轮机&r最高可以消耗128mB/t&7蒸汽&r以产生128EU/t的电力。"
		""
		"如果你还没有将&2大型蒸汽锅炉&r升级为高级版本，现在就赶紧去升级吧！"

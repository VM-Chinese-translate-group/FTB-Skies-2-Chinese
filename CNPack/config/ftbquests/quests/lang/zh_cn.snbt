	quest.7380416E70BEAD65.quest_desc: ["&aFlax Seeds&r give you string when harvested."]
	quest.7380416E70BEAD65.title: "&a亚麻种子"
	quest.73846333D68F6339.title: "&f马铃薯农场"
	quest.738BF8D6430694F4.quest_desc: [
		"By combining &dRaw Titanium Ore&r with &eManganese Sulfuric Solution&r in an &2Electric Blast Furnace&r, you can make &cTitanium Hot Ingots&r."
